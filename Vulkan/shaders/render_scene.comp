#version 450
#extension GL_GOOGLE_include_directive : require

#include "../../common/scene_rt.glsl"

layout(std140, set = 0, binding = 0) uniform UniformBuffer {
    GlassUniformsData uniforms;
};

layout(std430, set = 0, binding = 1) readonly buffer BVHBuffer {
    GPUBVHNode bvhNodes[];
};

layout(std430, set = 0, binding = 2) readonly buffer TriBuffer {
    GPUTriangle triangles[];
};

layout(set = 0, binding = 7, rgba32f) writeonly uniform image2D outTexture;
layout(set = 0, binding = 8) uniform sampler2D samplerIrradianceAtlas;
layout(set = 0, binding = 9) uniform sampler2D samplerCausticTexture;

#include "../../common/scene_intersect.glsl"

layout(local_size_x = 16, local_size_y = 16, local_size_z = 1) in;

vec3 sampleSurfaceAtlas(uint surfaceId, float u, float v) {
    float uTexel = (clamp(u, 0.001, 0.999) * float(kAtlasSurfaceWidth - 1u) + 0.5) / float(kAtlasSurfaceWidth * kNumSurfaces);
    float atlasU = (float(surfaceId) / float(kNumSurfaces)) + uTexel;
    float atlasV = (clamp(v, 0.001, 0.999) * float(kAtlasSurfaceHeight - 1u) + 0.5) / float(kAtlasSurfaceHeight);
    return texture(samplerIrradianceAtlas, vec2(atlasU, atlasV)).rgb;
}

vec3 sampleIrradianceAtlas(HitRecord hit) {
    if (hit.objectId == 2u) {
        float u = (hit.position.x - kRoomMinX) / (kRoomMaxX - kRoomMinX);
        float v = (hit.position.z - kRoomMinZ) / (kRoomMaxZ - kRoomMinZ);
        return sampleSurfaceAtlas(0u, u, v);
    } else if (hit.objectId == 3u) {
        float u = (hit.position.x - kRoomMinX) / (kRoomMaxX - kRoomMinX);
        float v = (hit.position.z - kRoomMinZ) / (kRoomMaxZ - kRoomMinZ);
        return sampleSurfaceAtlas(1u, u, v);
    } else if (hit.objectId == 1u) {
        float u = (hit.position.x - kRoomMinX) / (kRoomMaxX - kRoomMinX);
        float v = (hit.position.y - kRoomMinY) / (kRoomMaxY - kRoomMinY);
        return sampleSurfaceAtlas(2u, u, v);
    } else if (hit.objectId == 4u || hit.objectId == 6u) {
        float u = (hit.position.z - kRoomMinZ) / (kRoomMaxZ - kRoomMinZ);
        float v = (hit.position.y - kRoomMinY) / (kRoomMaxY - kRoomMinY);
        return sampleSurfaceAtlas(3u, u, v);
    } else if (hit.objectId == 5u) {
        float u = (hit.position.z - kRoomMinZ) / (kRoomMaxZ - kRoomMinZ);
        float v = (hit.position.y - kRoomMinY) / (kRoomMaxY - kRoomMinY);
        return sampleSurfaceAtlas(4u, u, v);
    }

    float u_xz = (hit.position.x - kRoomMinX) / (kRoomMaxX - kRoomMinX);
    float v_xz = (hit.position.z - kRoomMinZ) / (kRoomMaxZ - kRoomMinZ);

    float u_xy = (hit.position.x - kRoomMinX) / (kRoomMaxX - kRoomMinX);
    float v_xy = (hit.position.y - kRoomMinY) / (kRoomMaxY - kRoomMinY);

    float u_yz = (hit.position.z - kRoomMinZ) / (kRoomMaxZ - kRoomMinZ);
    float v_yz = (hit.position.y - kRoomMinY) / (kRoomMaxY - kRoomMinY);

    vec3 irrFloor = sampleSurfaceAtlas(0u, u_xz, v_xz);
    vec3 irrCeil  = sampleSurfaceAtlas(1u, u_xz, v_xz);
    vec3 irrBack  = sampleSurfaceAtlas(2u, u_xy, v_xy);
    vec3 irrLeft  = sampleSurfaceAtlas(3u, u_yz, v_yz);
    vec3 irrRight = sampleSurfaceAtlas(4u, u_yz, v_yz);

    float wFloor = max(0.0, -hit.normal.y);
    float wCeil  = max(0.0,  hit.normal.y);
    float wBack  = max(0.0,  hit.normal.z);
    float wLeft  = max(0.0, -hit.normal.x);
    float wRight = max(0.0,  hit.normal.x);

    float wSum = wFloor + wCeil + wBack + wLeft + wRight + 1e-4;
    return (wFloor * irrFloor + wCeil * irrCeil + wBack * irrBack + wLeft * irrLeft + wRight * irrRight) / wSum;
}

vec3 evaluateSurfaceRadiance(HitRecord hit, Ray ray, bool useCascadeGI) {
    if (!hit.hit) {
        return getSkyRadiance(ray.direction, normalize(uniforms.sunDirection));
    }

    vec3 L = normalize(uniforms.sunDirection);
    float NdotL = max(0.0, dot(hit.normal, L));
    vec3 directSun = vec3(0.0);

    if (NdotL > 0.0) {
        Ray shadowRay;
        shadowRay.origin = hit.position + hit.normal * 0.002;
        shadowRay.direction = L;

        HitRecord shadowHit = intersectScene(shadowRay, false, 0u);
        if (!shadowHit.hit) {
            directSun = uniforms.sunColor * (uniforms.sunIntensity * NdotL);
        }
    }

    vec3 causticRad = vec3(0.0);
    if (hit.objectId == 2u) {
        float uFloor = (hit.position.x - kFloorMinX) / (kFloorMaxX - kFloorMinX);
        float vFloor = (hit.position.z - kFloorMinZ) / (kFloorMaxZ - kFloorMinZ);
        if (uFloor >= 0.0 && uFloor <= 1.0 && vFloor >= 0.0 && vFloor <= 1.0) {
            causticRad = texture(samplerCausticTexture, vec2(uFloor, vFloor)).rgb;
        }
    }

    vec3 indirectGI = vec3(0.0);
    if (useCascadeGI) {
        vec3 E = sampleIrradianceAtlas(hit);
        indirectGI = E * hit.albedo;
    } else {
        vec3 baselineAmbient = vec3(0.04);
        indirectGI = baselineAmbient * hit.albedo;
    }

    return (directSun + causticRad) * hit.albedo + indirectGI;
}

void main() {
    uvec2 tid = gl_GlobalInvocationID.xy;
    if (tid.x >= uniforms.width || tid.y >= uniforms.height) return;

    vec2 uv = (vec2(tid) + 0.5) / vec2(float(uniforms.width), float(uniforms.height));
    vec2 ndc = uv * 2.0 - 1.0;
    ndc.y = -ndc.y;

    vec4 clipPos = vec4(ndc.x, ndc.y, 1.0, 1.0);
    vec4 viewPos = uniforms.projectionInverse * clipPos;
    viewPos /= viewPos.w;
    vec3 worldDir = normalize((uniforms.viewInverse * vec4(viewPos.xyz, 0.0)).xyz);

    Ray primaryRay;
    primaryRay.origin = uniforms.cameraPosition;
    primaryRay.direction = worldDir;

    HitRecord primaryHit = intersectScene(primaryRay, true, uniforms.numTeapotNodes);

    vec3 pixelColor = vec3(0.0);

    if (!primaryHit.hit) {
        pixelColor = getSkyRadiance(primaryRay.direction, normalize(uniforms.sunDirection));
    } else if (!primaryHit.isGlass) {
        pixelColor = evaluateSurfaceRadiance(primaryHit, primaryRay, uniforms.renderMode != 0u);
    } else {
        vec3 P1 = primaryHit.position;
        vec3 N1 = primaryHit.normal;
        vec3 V = -primaryRay.direction;
        float cosThetaI = clamp(dot(N1, V), 0.0, 1.0);

        float objIor = primaryHit.ior;
        float objDisp = primaryHit.dispersion;
        vec3 objAbs = primaryHit.absorption;

        if (uniforms.renderMode == 0u) {
            float F = dielectricFresnel(cosThetaI, 1.0, objIor);

            vec3 R = reflect(primaryRay.direction, N1);
            Ray reflRay;
            reflRay.origin = P1 + N1 * 0.002;
            reflRay.direction = R;
            HitRecord reflHit = intersectScene(reflRay, false, 0u);
            vec3 reflColor = evaluateSurfaceRadiance(reflHit, reflRay, false);

            vec3 T;
            vec3 refrColor = vec3(0.0);
            if (refractRay(primaryRay.direction, N1, 1.0 / objIor, T)) {
                Ray insideRay;
                insideRay.origin = P1 - N1 * 0.002;
                insideRay.direction = T;

                float tExit;
                vec3 nExit;
                bool exitOk = false;
                if (primaryHit.objectId == 10u) {
                    exitOk = intersectTeapotBVH(insideRay, uniforms.numTeapotNodes, tExit, nExit);
                } else if (primaryHit.objectId == 11u) {
                    exitOk = intersectSphere(insideRay, kSphereCenter, kSphereRadius, 0.001, tExit, nExit);
                } else if (primaryHit.objectId == 12u) {
                    exitOk = intersectCylinder(insideRay, kCylinderCenter, kCylinderRadius, kCylinderHeight, 0.001, tExit, nExit);
                } else {
                    exitOk = intersectTriangularPrism(insideRay, kPrismCenter, kPrismSide, kPrismHeight, 0.001, tExit, nExit);
                }

                if (exitOk) {
                    vec3 P2 = insideRay.origin + insideRay.direction * tExit;
                    vec3 N2 = -nExit;
                    vec3 T2;
                    if (refractRay(T, N2, objIor / 1.0, T2)) {
                        Ray exitRay;
                        exitRay.origin = P2 + T2 * 0.005;
                        exitRay.direction = T2;
                        HitRecord exitHit = intersectScene(exitRay, false, 0u);
                        refrColor = evaluateSurfaceRadiance(exitHit, exitRay, false);
                    }
                }
            }

            pixelColor = F * reflColor + (1.0 - F) * refrColor;
        } else {
            float disp = (uniforms.renderMode == 3u) ? (objDisp * 1.6) : objDisp;
            float iorR = objIor - disp;
            float iorG = objIor;
            float iorB = objIor + disp;

            float F_R = dielectricFresnel(cosThetaI, 1.0, iorR);
            float F_G = dielectricFresnel(cosThetaI, 1.0, iorG);
            float F_B = dielectricFresnel(cosThetaI, 1.0, iorB);
            vec3 F = vec3(F_R, F_G, F_B);

            vec3 reflDir = reflect(primaryRay.direction, N1);
            Ray reflRay;
            reflRay.origin = P1 + N1 * 0.003;
            reflRay.direction = reflDir;
            HitRecord reflHit = intersectScene(reflRay, false, 0u);
            vec3 reflColor = evaluateSurfaceRadiance(reflHit, reflRay, true);

            vec3 T_R, T_G, T_B;
            bool okR = refractRay(primaryRay.direction, N1, 1.0 / iorR, T_R);
            bool okG = refractRay(primaryRay.direction, N1, 1.0 / iorG, T_G);
            bool okB = refractRay(primaryRay.direction, N1, 1.0 / iorB, T_B);

            vec3 refrColor = vec3(0.0);

            if (okG) {
                Ray insideRayG;
                insideRayG.origin = P1 + T_G * 0.003;
                insideRayG.direction = T_G;

                float tExit;
                vec3 nExit;
                bool exitOk = false;

                if (primaryHit.objectId == 10u) {
                    exitOk = intersectTeapotBVH(insideRayG, uniforms.numTeapotNodes, tExit, nExit);
                } else if (primaryHit.objectId == 11u) {
                    exitOk = intersectSphere(insideRayG, kSphereCenter, kSphereRadius, 0.001, tExit, nExit);
                } else if (primaryHit.objectId == 12u) {
                    exitOk = intersectCylinder(insideRayG, kCylinderCenter, kCylinderRadius, kCylinderHeight, 0.001, tExit, nExit);
                } else if (primaryHit.objectId == 13u) {
                    exitOk = intersectTriangularPrism(insideRayG, kPrismCenter, kPrismSide, kPrismHeight, 0.001, tExit, nExit);
                } else {
                    vec3 slabMin = vec3(1.00, 0.0, 0.35);
                    vec3 slabMax = vec3(1.70, 0.06, 1.05);
                    exitOk = intersectBox(insideRayG, slabMin, slabMax, 0.001, tExit, nExit);
                }

                if (exitOk) {
                    float internalDist = tExit;
                    vec3 P2 = insideRayG.origin + insideRayG.direction * tExit;
                    vec3 N2 = -nExit;

                    vec3 absorption = beerLambertAbsorption(objAbs, internalDist);

                    vec3 T2_R, T2_G, T2_B;
                    bool exitOkR = refractRay(okR ? T_R : T_G, N2, iorR / 1.0, T2_R);
                    bool exitOkG = refractRay(T_G, N2, iorG / 1.0, T2_G);
                    bool exitOkB = refractRay(okB ? T_B : T_G, N2, iorB / 1.0, T2_B);

                    if (uniforms.renderMode == 2u) {
                        float coneAngle = uniforms.glassRoughness * 0.28;
                        vec3 wT = normalize(exitOkG ? T2_G : reflect(T_G, nExit));
                        vec3 upVec = abs(wT.y) < 0.99 ? vec3(0.0, 1.0, 0.0) : vec3(1.0, 0.0, 0.0);
                        vec3 uVec = normalize(cross(wT, upVec));
                        vec3 vVec = cross(wT, uVec);

                        vec3 ignMagic = vec3(0.06711056, 0.00583715, 52.9829189);
                        float ign = fract(ignMagic.z * fract(dot(vec2(tid), ignMagic.xy)));
                        float phi = ign * 6.283185307;
                        float cosPhi = cos(phi);
                        float sinPhi = sin(phi);

                        const int kSamples = 16;
                        vec3 accumRad = vec3(0.0);
                        float weightSum = 0.0;

                        for (int s = 0; s < kSamples; s++) {
                            float theta = float(s) * 2.39996323;
                            float r = sqrt((float(s) + 0.5) / float(kSamples));

                            float unrotX = r * cos(theta);
                            float unrotY = r * sin(theta);
                            float rotX = unrotX * cosPhi - unrotY * sinPhi;
                            float rotY = unrotX * sinPhi + unrotY * cosPhi;

                            vec2 off = vec2(rotX, rotY) * coneAngle;
                            vec3 sampleDir = normalize(wT + off.x * uVec + off.y * vVec);

                            float weight = exp(-1.2 * r * r);

                            Ray coneRay;
                            coneRay.origin = P2 + sampleDir * 0.005;
                            coneRay.direction = sampleDir;
                            HitRecord coneHit = intersectScene(coneRay, false, 0u);
                            accumRad += weight * evaluateSurfaceRadiance(coneHit, coneRay, true);
                            weightSum += weight;
                        }
                        refrColor = (accumRad / weightSum) * absorption;
                    } else {
                        vec3 dirR = exitOkR ? T2_R : reflect(okR ? T_R : T_G, nExit);
                        Ray exitRayR;
                        exitRayR.origin = P2 + dirR * 0.012;
                        exitRayR.direction = dirR;
                        HitRecord hitR = intersectScene(exitRayR, false, 0u);
                        float radR = evaluateSurfaceRadiance(hitR, exitRayR, true).r;

                        vec3 dirG = exitOkG ? T2_G : reflect(T_G, nExit);
                        Ray exitRayG;
                        exitRayG.origin = P2 + dirG * 0.012;
                        exitRayG.direction = dirG;
                        HitRecord hitG = intersectScene(exitRayG, false, 0u);
                        float radG = evaluateSurfaceRadiance(hitG, exitRayG, true).g;

                        vec3 dirB = exitOkB ? T2_B : reflect(okB ? T_B : T_G, nExit);
                        Ray exitRayB;
                        exitRayB.origin = P2 + dirB * 0.012;
                        exitRayB.direction = dirB;
                        HitRecord hitB = intersectScene(exitRayB, false, 0u);
                        float radB = evaluateSurfaceRadiance(hitB, exitRayB, true).b;

                        refrColor = vec3(radR, radG, radB) * absorption;
                    }
                } else {
                    Ray escapeRay;
                    escapeRay.origin = P1 + T_G * 0.02;
                    escapeRay.direction = T_G;
                    HitRecord escapeHit = intersectScene(escapeRay, false, 0u);
                    refrColor = evaluateSurfaceRadiance(escapeHit, escapeRay, true);
                }
            }

            pixelColor = F * reflColor + (vec3(1.0) - F) * refrColor;

            vec3 L = normalize(uniforms.sunDirection);
            vec3 H = normalize(L + V);
            float NdotH = max(0.0, dot(N1, H));
            float specPow = (uniforms.renderMode == 2u) ? 24.0 : 512.0;
            float specHighlight = (NdotH > 1e-4) ? (pow(NdotH, specPow) * 1.5) : 0.0;
            pixelColor += uniforms.sunColor * uniforms.sunIntensity * specHighlight * F;
        }
    }

    vec3 finalColor = toneMapACES(pixelColor);
    imageStore(outTexture, ivec2(tid), vec4(finalColor, 1.0));
}
