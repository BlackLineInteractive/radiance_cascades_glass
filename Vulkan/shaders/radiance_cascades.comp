#version 450
#extension GL_GOOGLE_include_directive : require

#include "../../common/scene_rt.glsl"

layout(std140, set = 0, binding = 0) uniform UniformBuffer {
    GlassUniformsData uniforms;
};

layout(std430, set = 0, binding = 1) readonly buffer BVHBuffer {
    GPUBVHNode bvhNodes[];
};

layout(std430, set = 0, binding = 2) readonly buffer TriBuffer {
    GPUTriangle triangles[];
};

layout(set = 0, binding = 4, rgba32f) uniform writeonly image2D irradianceAtlas;

#include "../../common/scene_intersect.glsl"

layout(local_size_x = 16, local_size_y = 16, local_size_z = 1) in;

// Cascade N covers [kCascadeRanges[N], kCascadeRanges[N+1]] along a ray. The
// intervals do not overlap, so a full hemisphere gather is the sum of the four.
const float kCascadeRanges[5] = float[5](0.005, 0.25, 0.80, 2.50, 100.0);

const int kRaysC0 = 16;
const int kRaysC1 = 32;
const int kRaysC2 = 64;
const int kRaysC3 = 128;

vec3 evalSurfaceDirectLighting(HitRecord hit, vec3 sunDir, vec3 sunCol, float sunInt, uint numNodes) {
    float NdotL = max(0.0, dot(hit.normal, sunDir));
    vec3 sunIllum = vec3(0.0);
    if (NdotL > 0.0) {
        Ray sRay;
        sRay.origin = hit.position + hit.normal * 0.002;
        sRay.direction = sunDir;
        HitRecord sHit = intersectSceneInterval(sRay, 0.001, 100.0, false, numNodes);
        if (!sHit.hit) {
            sunIllum = sunCol * (sunInt * NdotL);
        }
    }
    vec3 ambient = vec3(0.08);
    return (sunIllum + ambient) * hit.albedo;
}

vec4 traceCascadeInterval(vec3 origin, vec3 dir, float tMin, float tMax, vec3 sunDir, vec3 sunCol, float sunInt, uint numNodes) {
    Ray probeRay;
    probeRay.origin = origin;
    probeRay.direction = dir;
    HitRecord hit = intersectSceneInterval(probeRay, tMin, tMax, false, numNodes);
    if (hit.hit) {
        vec3 hitRad = evalSurfaceDirectLighting(hit, sunDir, sunCol, sunInt, numNodes);
        // Fade near the far edge so the interval boundary is not a hard ring.
        float tNorm = clamp((hit.distance - tMin) / max(1e-4, tMax - tMin), 0.0, 1.0);
        float boundaryFade = smoothstep(0.85, 1.0, tNorm);
        return vec4(hitRad, boundaryFade);
    }
    return vec4(0.0, 0.0, 0.0, 1.0);
}

// Cosine-weighted Fibonacci direction `index` out of `count`, in the probe's
// tangent frame. Cascade N+1 uses 2*count, so index 2i and 2i+1 are the two
// directions that merge back into index i one level down.
vec3 cascadeDirection(Basis tbn, int index, int count, float jitter) {
    float cosTheta = sqrt(max(0.0, 1.0 - (float(index) + 0.5) / float(count)));
    float sinTheta = sqrt(max(0.0, 1.0 - cosTheta * cosTheta));
    float phi = float(index) * 2.399963229728 + jitter;
    return basisToWorld(tbn, vec3(cos(phi) * sinTheta, sin(phi) * sinTheta, cosTheta));
}

// Probes of cascade N sit at the centre of every `stride`-texel block, so
// higher cascades are shared by progressively larger patches of the atlas.
void cascadeProbe(uint surfaceId, uint lx, uint ly, int stride, out vec3 origin, out Basis tbn) {
    int bx = clamp(int(lx) / stride * stride, 0, int(kAtlasSurfaceWidth) - stride);
    int by = clamp(int(ly) / stride * stride, 0, int(kAtlasSurfaceHeight) - stride);
    vec2 uv = (vec2(bx, by) + float(stride) * 0.5 + 0.5) / float(kAtlasSurfaceWidth);

    vec3 pos, nor;
    getSurfaceGeometry(surfaceId, uv, pos, nor);
    tbn = makeTBN(nor);
    origin = pos + nor * 0.004;
}

// One invocation per atlas texel. The four cascades are evaluated as a
// depth-first walk of the direction tree rather than four flat passes, which
// keeps the whole merge in registers instead of spilling ~3 KB of arrays.
void main() {
    uvec2 tid = gl_GlobalInvocationID.xy;
    if (tid.x >= kAtlasSurfaceWidth * kNumSurfaces || tid.y >= kAtlasSurfaceHeight) return;

    uint surfaceId = tid.x / kAtlasSurfaceWidth;
    uint lx = tid.x % kAtlasSurfaceWidth;
    uint ly = tid.y;

    vec3 sunDir = normalize(uniforms.sunDirection);
    float jitter = fract(sin(dot(vec2(lx, ly) + vec2(float(surfaceId) * 37.0),
                                vec2(12.9898, 78.233))) * 43758.5453) * (2.0 * kPi);

    vec3 originC0, originC1, originC2, originC3;
    Basis tbnC0, tbnC1, tbnC2, tbnC3;
    cascadeProbe(surfaceId, lx, ly, 1, originC0, tbnC0);
    cascadeProbe(surfaceId, lx, ly, 2, originC1, tbnC1);
    cascadeProbe(surfaceId, lx, ly, 4, originC2, tbnC2);
    cascadeProbe(surfaceId, lx, ly, 8, originC3, tbnC3);

    vec3 accumIrradiance = vec3(0.0);

    for (int i0 = 0; i0 < kRaysC0; i0++) {
        vec3 dir0 = cascadeDirection(tbnC0, i0, kRaysC0, jitter);
        vec4 seg0 = traceCascadeInterval(originC0, dir0, kCascadeRanges[0], kCascadeRanges[1],
                                         sunDir, uniforms.sunColor, uniforms.sunIntensity, uniforms.numTeapotNodes);
        if (seg0.w <= 0.0) {
            accumIrradiance += seg0.rgb;
            continue;
        }

        vec3 fromC1 = vec3(0.0);
        for (int a = 0; a < 2; a++) {
            int i1 = 2 * i0 + a;
            vec3 dir1 = cascadeDirection(tbnC1, i1, kRaysC1, jitter);
            vec4 seg1 = traceCascadeInterval(originC1, dir1, kCascadeRanges[1], kCascadeRanges[2],
                                             sunDir, uniforms.sunColor, uniforms.sunIntensity, uniforms.numTeapotNodes);
            if (seg1.w <= 0.0) {
                fromC1 += 0.5 * seg1.rgb;
                continue;
            }

            vec3 fromC2 = vec3(0.0);
            for (int b = 0; b < 2; b++) {
                int i2 = 2 * i1 + b;
                vec3 dir2 = cascadeDirection(tbnC2, i2, kRaysC2, jitter);
                vec4 seg2 = traceCascadeInterval(originC2, dir2, kCascadeRanges[2], kCascadeRanges[3],
                                                 sunDir, uniforms.sunColor, uniforms.sunIntensity, uniforms.numTeapotNodes);
                if (seg2.w <= 0.0) {
                    fromC2 += 0.5 * seg2.rgb;
                    continue;
                }

                vec3 fromC3 = vec3(0.0);
                for (int c = 0; c < 2; c++) {
                    int i3 = 2 * i2 + c;
                    vec3 dir3 = cascadeDirection(tbnC3, i3, kRaysC3, jitter);
                    vec4 seg3 = traceCascadeInterval(originC3, dir3, kCascadeRanges[3], kCascadeRanges[4],
                                                     sunDir, uniforms.sunColor, uniforms.sunIntensity, uniforms.numTeapotNodes);
                    // Nothing left to merge past the last cascade, so the
                    // residual transmittance picks up the sky.
                    fromC3 += 0.5 * (seg3.rgb + seg3.w * getSkyRadiance(dir3, sunDir) * 1.5);
                }
                fromC2 += 0.5 * (seg2.rgb + seg2.w * fromC3);
            }
            fromC1 += 0.5 * (seg1.rgb + seg1.w * fromC2);
        }
        accumIrradiance += seg0.rgb + seg0.w * fromC1;
    }

    imageStore(irradianceAtlas, ivec2(tid), vec4(accumIrradiance / float(kRaysC0), 1.0));
}
